  "name": "Unified Kanban",
  "version": "1.0.0",
  "description": "Mon board Kanban intersite personnalisé",
  "permissions": [
    "storage"
  ],
  "action": {
    "default_title": "Ouvrir Unified Kanban",
    "default_popup": "index.html",
